# Local/private config goes in the include
[include]
	path = ~/.gitconfig.local
[hub]
	protocol = https
[alias]
	co = checkout
	promote = !$ZSH/bin/git-promote
	wtf = !$ZSH/bin/git-wtf
	rank-contributors = !$ZSH/bin/git-rank-contributors
	count = !git shortlog -sn
	f = !git fetch
	rh = !git reset --hard
	s = status
	cam = !git add --all && git commit --verbose
	poh = !git push origin HEAD
	ll = log --stat --abbrev-commit
	alias = !git config --list | grep 'alias\\.' | sed 's/alias\\.\\([^=]*\\)=\\(.*\\)/\\1\\\t => \\2/' | sort
	rop = !git fetch origin && git reset --hard origin/main
	rom = !git fetch origin && git rebase origin/main --autostash
	rbo = !git fetch origin && git rebase -i origin/main
	conflicts = !git diff --name-only --diff-filter=U
	db = !git branch --merged | grep -v "*" | xargs -n 1 git branch -d
	lo = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	aidiff = !git --no-pager diff --unified=3 --color=never
	pushf = push --force-with-lease
[color]
	diff = auto
	status = auto
	branch = auto
	ui = true
[core]
	excludesfile = ~/.gitignore
	editor = vim
	pager = delta
	fsmonitor = true
[apply]
	whitespace = nowarn
[mergetool]
	keepBackup = false
[difftool]
	prompt = false
[help]
	autocorrect = 1
[push]
	# See `git help config` (search for push.default)
	# for more information on different options of the below setting.
	#
	# Setting to git 2.0 default to suppress warning message
	default = simple
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[safe]
	directory = /opt/homebrew/Library/Taps/homebrew/homebrew-core
	directory = /opt/homebrew/Library/Taps/homebrew/homebrew-cask
[credential "https://dev.azure.com"]
	useHttpPath = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[credential "https://huggingface.co"]
	provider = generic
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[pull]
	rebase = true
[rebase]
	autostash = true
